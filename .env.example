# 이 파일은 예시입니다. 실제 값은 Git에서 제외된 .env에 저장합니다.
# uv run --env-file .env uvicorn app.main:app --host 127.0.0.1 --port 8000 --reload
KANBAN_DATABASE_URL=postgresql://ttodo_worker.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
KANBAN_BOARD_ID=BOARD_UUID
KANBAN_ACTOR_PROFILE_ID=WORKSPACE_MEMBER_PROFILE_UUID

# 같은 컴퓨터의 로컬 개발에서는 비워 두고, 공유 서버에서는 토큰을 설정합니다.
TTODO_API_TOKEN=
TTODO_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
